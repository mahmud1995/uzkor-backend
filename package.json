{
  "name": "preorder-commerce",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "dev": "node --watch -r ts-node/register src/main.ts",
    "migration:up": "mikro-orm migration:up",
    "migration:down": "mikro-orm migration:down",
    "test": "npm run build && tsx --test test/*.test.ts",
    "seed": "tsx scripts/seed.ts",
    "openapi:export": "ts-node --compiler-options '{\"rootDir\":\".\"}' scripts/export-openapi.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/swagger": "^11.0.0",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/schedule": "^6.0.0",
    "@mikro-orm/core": "~6.6.0",
    "@mikro-orm/postgresql": "~6.6.0",
    "@mikro-orm/migrations": "~6.6.0",
    "@mikro-orm/nestjs": "^6.1.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "dotenv": "^16.4.7",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@mikro-orm/cli": "~6.6.0",
    "@types/node": "^24.0.0",
    "@types/express": "^5.0.0",
    "typescript": "^5.9.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.0",
    "supertest": "^7.1.0",
    "@types/supertest": "^6.0.0"
  },
  "mikro-orm": {
    "configPaths": [
      "./src/database/mikro-orm.config.ts"
    ],
    "useTsNode": true
  }
}
